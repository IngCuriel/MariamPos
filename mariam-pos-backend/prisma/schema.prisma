// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  code        String?  @unique // Opcional para permitir códigos generados automáticamente
  name        String
  status      Int?
  saleType    String?
  price       Float // PRECIO BASE (precio por pieza) → para compatibilidad
  cost        Float?
  description String?
  icon        String?
  createdAt   DateTime @default(now())

  // Nuevas propiedades para inventario
  trackInventory Boolean? @default(false) // si el producto usa inventario 

  // 🔄 Campos de sincronización
  syncStatus String @default("pendiente") // pendiente, enviado
  branch     String? @default("Sucursal Default") // Sucursal del producto

  inventory Inventory? // ← 1:1
  movements InventoryMovement[]

  // 🆕 NUEVO: Identificador de Kit/Combo
  isKit Boolean @default(false) // Si es true, es un kit/combo

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Unidad de medida (informativa): pza, kg, L, caja, etc. Opcional.
  unitId Int?
  unit   UnitOfMeasure? @relation(fields: [unitId], references: [id])

  // Modo de precio: "simple" (default) o "tiered" (precio escalonado por cantidad).
  // Excluyente con presentaciones: un producto es simple, por presentaciones, o tiered.
  pricingMode String @default("simple")

  // Tramos de precio por cantidad (solo si pricingMode = "tiered").
  priceTiers ProductPriceTier[]

  // 🔥 Nueva relación (un producto puede tener varias presentaciones)
  presentations ProductPresentation[]

  // Relación con envases
  containers Container[]

  saleDetails        SaleDetail[]
  pendingSaleDetails PendingSaleDetail[]

  // 🆕 NUEVO: Relación con items del kit (cuando este Product ES un kit)
  kitItems KitItem[] @relation("Kit")

  // 🆕 NUEVO: Relación con kits (cuando este Product está DENTRO de un kit)
  kitsAsItem     KitItem[]        @relation("KitProduct")
  PurchaseDetail PurchaseDetail[]

  @@index([code])
  @@index([name])
  @@index([description])
  @@index([isKit]) // Índice para filtrar kits rápidamente
  @@index([syncStatus])
  @@index([branch])
  @@index([unitId])
}

// ------------------------------------------------------------
// Unidades de medida (catálogo informativo): pieza, kg, litro, caja, etc.
// No afecta el inventario ni cálculos; solo describe cómo se vende el producto.
// ------------------------------------------------------------
model UnitOfMeasure {
  id           Int      @id @default(autoincrement())
  name         String // Ej: "Kilogramo", "Litro", "Pieza"
  abbreviation String // Ej: "kg", "L", "pza"
  status       Int?     // null o != 0 = activo, 0 = inactivo (patrón Product/Container)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 🔄 Campos de sincronización
  syncStatus String  @default("pendiente")
  branch     String? @default("Sucursal Default")

  products Product[]

  @@index([abbreviation])
  @@index([status])
  @@index([syncStatus])
}

model ProductPresentation {
  id        Int     @id @default(autoincrement())
  name      String // Ej: "Pieza", "Cono", "Six"
  quantity  Int // Ej: 1, 30, 6 → unidades reales
  unitPrice Float // Precio por unidad en esta presentación
  isDefault Boolean @default(false)

  product   Product @relation(fields: [productId], references: [id])
  productId Int

  // 🔄 Campos de sincronización
  syncStatus String @default("pendiente") // pendiente, enviado
  branch     String? // Sucursal (heredada del producto)

  // Relación con envases
  containers Container[]

  // 🆕 NUEVO: Relación con items de kit (cuando esta presentación está en un kit)
  kitItems KitItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([syncStatus])
  @@index([branch])
}

// ------------------------------------------------------------
// Tramos de precio por cantidad (precio escalonado / tiered).
// Ej: 1-10 => $5, 11-20 => $4, 21+ => $3.
// Escalón SIMPLE: toda la cantidad se cobra al precio del tramo donde cae.
// ------------------------------------------------------------
model ProductPriceTier {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  minQty    Int // cantidad mínima del tramo (inclusive)
  maxQty    Int? // cantidad máxima del tramo (inclusive); null = "en adelante"
  unitPrice Float // precio por unidad en este tramo

  // 🔄 Sincronización
  syncStatus String  @default("pendiente")
  branch     String? @default("Sucursal Default")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([syncStatus])
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  showInPOS Boolean @default(false)

  // 🔄 Campos de sincronización
  syncStatus String @default("pendiente") // pendiente, enviado
  branch     String? @default("Sucursal Default") // Sucursal de la categoría

  // Departamento al que pertenece la categoría (opcional: puede no tener).
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  Product Product[]

  // Prefijo de código ligado a esta categoría (opcional, 1:1).
  codePrefix CategoryCodePrefix?

  @@index([syncStatus])
  @@index([branch])
  @@index([departmentId])
}

// ------------------------------------------------------------
// Prefijos de código por categoría.
// Permite generar códigos consecutivos automáticos: PREFIX-001, PREFIX-002…
// El consecutivo (lastNumber) se reserva al GUARDAR el producto, no al generarlo.
// ------------------------------------------------------------
model CategoryCodePrefix {
  id         Int      @id @default(autoincrement())
  categoryId String   @unique
  category   Category @relation(fields: [categoryId], references: [id])

  prefix     String // ej: "ABA-REF"
  lastNumber Int      @default(0) // último consecutivo usado
  padding    Int      @default(3) // ceros a la izquierda: 001

  // 🔄 Campos de sincronización
  syncStatus String  @default("pendiente")
  branch     String? @default("Sucursal Default")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prefix])
  @@index([syncStatus])
}

// ------------------------------------------------------------
// Departamentos (agrupan categorías): Papelería, Abarrotes, etc.
// ------------------------------------------------------------
model Department {
  id          String   @id @default(uuid())
  name        String
  description String?
  icon        String?
  status      Int?     // null o != 0 = activo, 0 = inactivo (mismo criterio que Container/Product)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 🔄 Campos de sincronización
  syncStatus String  @default("pendiente")
  branch     String? @default("Sucursal Default")

  categories Category[]

  @@index([syncStatus])
  @@index([branch])
  @@index([status])
}

model Client {
  id    String  @id @default(uuid())
  name  String
  alias String? // Alias o apodo para identificar mejor al cliente
  phone String? // Número de celular/teléfono

  // Campos de crédito
  allowCredit Boolean @default(false) // Si el cliente puede comprar a crédito
  creditLimit Float   @default(0) // Límite de crédito permitido

  // Relaciones
  credits           ClientCredit[] // Créditos pendientes del cliente
  containerDeposits ClientContainerDeposit[] // Depósitos de envases pendientes

  @@index([name])
  @@index([alias])
  @@index([phone])
}

model Sale {
  id            Int      @id @default(autoincrement())
  folio         String?
  total         Float
  status        String? //Pendiente, Pagado
  paymentMethod String? // Efectivo, Tarjeta, etc.
  createdAt     DateTime @default(now())
  clientName    String?

  //Sucursal
  branch String? @default("Sucursal Defult")

  //Caja de cobro
  cashRegister String? @default("Caja 1")

  // Cajero que registró la venta (auditoría)
  createdBy String?

  // Monto recibido en efectivo (para arqueo/cambio)
  amountReceived Float?

  // Folio/referencia del comprobante (pago con tarjeta)
  paymentReference String?

  // Nuevo campo de sincronización
  syncStatus String @default("pendiente") // pendiente, enviado

  // Relación con turno de caja
  shiftId Int?
  shift   CashRegisterShift? @relation(fields: [shiftId], references: [id])

  // Relación con los detalles
  details SaleDetail[]

  // Relación con créditos (si la venta generó un crédito)
  credit ClientCredit?

  @@index([folio])
  @@index([syncStatus])
  @@index([shiftId])
}

model SaleDetail {
  id          Int      @id @default(autoincrement())
  quantity    Float
  price       Float
  subTotal    Float
  productName String?
  unitAbbrev  String? // Unidad de medida congelada al momento de la venta (ej: "kg")
  createdAt   DateTime @default(now())

  // Relación con Sale
  saleId Int
  sale   Sale @relation(fields: [saleId], references: [id])

  // Relación con Product
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

// ============================================================
// 🏭 MÓDULO DE INVENTARIO
// ============================================================

// ------------------------------------------------------------
// Tabla principal de inventario por producto y sucursal
// ------------------------------------------------------------
model Inventory {
  id Int @id @default(autoincrement())

  productId Int     @unique // ← IMPORTANTE
  product   Product @relation(fields: [productId], references: [id])

  currentStock     Int       @default(0)
  minStock         Int       @default(0)
  maxStock         Int?
  lastMovementDate DateTime?
  trackInventory   Boolean   @default(false)
  branch           String?

  // 🔄 Campo de sincronización
  syncStatus String @default("pendiente") // pendiente, enviado

  movements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([syncStatus])
}

// ------------------------------------------------------------
// Movimientos de inventario
// ------------------------------------------------------------
model InventoryMovement {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  inventoryId Int?
  inventory   Inventory? @relation(fields: [inventoryId], references: [id])

  type     InventoryMovementType
  quantity Int

  reason    String?
  reference String?
  notes     String?

  branch       String? // Sucursal
  cashRegister String? // Caja

  createdBy String?
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------
// Enum para tipos de movimientos
// ------------------------------------------------------------
enum InventoryMovementType {
  ENTRADA
  SALIDA
  AJUSTE
  TRANSFERENCIA
}

// ============================================================
// 💰 MÓDULO DE CORTE DE CAJA
// ============================================================

// ------------------------------------------------------------
// Turnos/Cortes de Caja
// ------------------------------------------------------------
model CashRegisterShift {
  id           Int     @id @default(autoincrement())
  shiftNumber  String  @unique // Folio único del turno
  branch       String // Sucursal
  cashRegister String // Caja (ej: "Caja 1")
  cashierName  String? // Nombre del cajero (por ahora string, luego puede ser FK a User)

  // Fechas del turno
  startTime DateTime  @default(now())
  endTime   DateTime?

  // Fondos
  initialCash  Float  @default(0) // Fondo inicial
  finalCash    Float? // Efectivo contado al cerrar
  expectedCash Float? // Efectivo esperado (calculado)
  difference   Float? // Diferencia (finalCash - expectedCash)

  // Totales por método de pago (calculados automáticamente)
  totalCash     Float @default(0) // Total en efectivo
  totalCard     Float @default(0) // Total en tarjeta
  totalTransfer Float @default(0) // Total en transferencia
  totalOther    Float @default(0) // Otros métodos

  // Estado
  status ShiftStatus @default(OPEN) // OPEN, CLOSED, CANCELLED

  // Observaciones
  notes String?

  // Relación con ventas
  sales Sale[]

  // Relación con movimientos de efectivo
  cashMovements CashMovement[]

  // Relación con depósitos de envases de clientes
  clientContainerDeposits ClientContainerDeposit[]

  // Relación con abonos a créditos recibidos en el turno
  creditPayments CreditPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branch, cashRegister])
  @@index([status])
  @@index([startTime])
}

// ------------------------------------------------------------
// Enum para estados de turno
// ------------------------------------------------------------
enum ShiftStatus {
  OPEN // Turno abierto
  CLOSED // Turno cerrado
  CANCELLED // Turno cancelado
}

// ------------------------------------------------------------
// Movimientos de Efectivo (Entradas y Salidas)
// ------------------------------------------------------------
model CashMovement {
  id      Int               @id @default(autoincrement())
  shiftId Int // Relación con el turno
  shift   CashRegisterShift @relation(fields: [shiftId], references: [id])

  type   CashMovementType // ENTRADA o SALIDA
  amount Float // Monto del movimiento
  reason String? // Razón del movimiento (ej: "Pago a proveedor", "Cobro recibido")
  notes  String? // Notas adicionales

  createdBy String? // Usuario que creó el movimiento
  createdAt DateTime @default(now())

  @@index([shiftId])
  @@index([type])
  @@index([createdAt])
}

// ------------------------------------------------------------
// Enum para tipos de movimiento de efectivo
// ------------------------------------------------------------
enum CashMovementType {
  ENTRADA // Entrada de efectivo a la caja
  SALIDA // Salida de efectivo de la caja
}

// ============================================================
// 👤 MÓDULO DE USUARIOS/CAJEROS
// ============================================================

model User {
  id       String     @id @default(uuid())
  name     String // Nombre completo del cajero
  email    String?    @unique // Email (opcional, para futuras autenticaciones)
  phone    String? // Teléfono
  username String?    @unique // Nombre de usuario (opcional)
  role     UserRole   @default(CASHIER) // Rol del usuario
  status   UserStatus @default(ACTIVE) // Estado: activo o inactivo
  branch   String? // Sucursal asignada
  notes    String? // Notas adicionales

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([role])
  @@index([email])
}

enum UserRole {
  ADMIN // Administrador
  MANAGER // Gerente
  CASHIER // Cajero
  SUPERVISOR // Supervisor
}

enum UserStatus {
  ACTIVE // Usuario activo
  INACTIVE // Usuario inactivo
}

// ============================================================
// 💳 MÓDULO DE CRÉDITOS
// ============================================================

// ------------------------------------------------------------
// Créditos Pendientes de Clientes
// ------------------------------------------------------------
model ClientCredit {
  id Int @id @default(autoincrement())

  // Relación con cliente
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // Relación con venta que generó el crédito
  saleId Int  @unique
  sale   Sale @relation(fields: [saleId], references: [id])

  // Montos
  originalAmount  Float // Monto original del crédito
  remainingAmount Float // Monto pendiente por pagar
  paidAmount      Float @default(0) // Monto total pagado hasta ahora

  // Estado
  status CreditStatus @default(PENDING) // PENDING, PARTIALLY_PAID, PAID

  // Fechas
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime? // Fecha en que se pagó completamente

  // Notas
  notes String?

  // Cajero que registró el crédito (la venta que lo generó)
  createdBy String?

  // Relación con pagos/abonos
  payments CreditPayment[]

  @@index([clientId])
  @@index([saleId])
  @@index([status])
  @@index([createdAt])
}

// ------------------------------------------------------------
// Abonos/Pagos a Créditos
// ------------------------------------------------------------
model CreditPayment {
  id Int @id @default(autoincrement())

  // Relación con crédito
  creditId Int
  credit   ClientCredit @relation(fields: [creditId], references: [id])

  // Monto del abono
  amount Float

  // Método de pago
  paymentMethod String? // Efectivo, Tarjeta, etc.

  // Notas
  notes String?

  // Usuario que registró el pago
  createdBy String?

  // Turno de caja en el que se recibió el abono (para arqueo/corte).
  // Se resuelve en el backend a partir del turno activo de la caja.
  shiftId Int?
  shift   CashRegisterShift? @relation(fields: [shiftId], references: [id])

  // Fecha
  createdAt DateTime @default(now())

  @@index([creditId])
  @@index([createdAt])
  @@index([shiftId])
}

// ------------------------------------------------------------
// Enum para estados de crédito
// ------------------------------------------------------------
enum CreditStatus {
  PENDING // Pendiente de pago
  PARTIALLY_PAID // Parcialmente pagado
  PAID // Completamente pagado
}

// ============================================================
// 🕓 MÓDULO DE VENTAS PENDIENTES
// ============================================================

// ------------------------------------------------------------
// Ventas Pendientes (Carritos guardados para cobrar después)
// ------------------------------------------------------------
model PendingSale {
  id           Int     @id @default(autoincrement())
  code         String  @unique // Código único generado automáticamente
  clientName   String? // Nombre del cliente para recordar
  total        Float // Total de la venta pendiente
  branch       String? @default("Sucursal Default")
  cashRegister String? @default("Caja 1")

  // Relación con los detalles del carrito
  details PendingSaleDetail[]

  // Fechas
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([clientName])
  @@index([createdAt])
}

// ------------------------------------------------------------
// Detalles de Venta Pendiente
// ------------------------------------------------------------
model PendingSaleDetail {
  id Int @id @default(autoincrement())

  // Relación con PendingSale
  pendingSaleId Int
  pendingSale   PendingSale @relation(fields: [pendingSaleId], references: [id], onDelete: Cascade)

  // Información del producto
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  // Datos de la venta
  quantity    Float // Cantidad
  price       Float // Precio unitario
  subTotal    Float // Subtotal (quantity * price)
  productName String? // Nombre del producto al momento de guardar

  // Información de presentación (si aplica)
  presentationId   Int? // ID de la presentación si se usó
  presentationName String? // Nombre de la presentación

  // Información de granel (si aplica)
  saleType  String? // "Pieza" o "Granel"
  basePrice Float? // Precio base para granel

  createdAt DateTime @default(now())

  @@index([pendingSaleId])
  @@index([productId])
}

// ============================================================
// 🍺 MÓDULO DE ENVASES RETORNABLES
// ============================================================

// ------------------------------------------------------------
// Envases Retornables
// ------------------------------------------------------------
model Container {
  id           Int    @id @default(autoincrement())
  name         String // Nombre del envase (ej: "Coca Vidrio", "Rega Cerveza")
  quantity     Int // Cantidad de envases
  importAmount Float // Importe del depósito por envase

  // Relación con producto (opcional - si no tiene presentación)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id])

  // Relación con presentación (opcional - si el producto tiene presentación)
  presentationId Int?
  presentation   ProductPresentation? @relation(fields: [presentationId], references: [id])

  // Notas adicionales
  notes String?

  // Estado (similar a Product: null o != 0 = activo, 0 = inactivo)
  status Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([presentationId])
  @@index([status])
}

// ============================================================
// 🍺 DEPÓSITOS DE ENVASES POR CLIENTE
// ============================================================

// ------------------------------------------------------------
// Depósitos de Envases de Clientes
// ------------------------------------------------------------
model ClientContainerDeposit {
  id Int @id @default(autoincrement())

  // Relación con cliente
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // Relación con venta que generó el depósito
  saleId Int? // Opcional, puede ser null si se crea manualmente

  // Información del depósito
  containerName String // Nombre del envase (ej: "Coca Vidrio")
  quantity      Int // Cantidad de envases
  importAmount  Float // Importe total del depósito (quantity * unitPrice)
  unitPrice     Float // Precio unitario del envase

  // Estado
  status ContainerDepositStatus @default(PENDING) // PENDING, RETURNED

  // Relación con turno de caja
  shiftId Int?
  shift   CashRegisterShift? @relation(fields: [shiftId], references: [id])

  // Relación con movimiento de efectivo
  cashMovementId Int? // ID del movimiento de efectivo generado

  // Notas
  notes String?

  // Auditoría de cajeros
  createdBy  String? // Cajero que registró/dio el envase
  returnedBy String? // Cajero que regresó el importe

  // Fechas
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  returnedAt DateTime? // Fecha en que se devolvieron los envases

  @@index([clientId])
  @@index([saleId])
  @@index([status])
  @@index([createdAt])
  @@index([shiftId])
}

// ------------------------------------------------------------
// Enum para estados de depósito de envases
// ------------------------------------------------------------
enum ContainerDepositStatus {
  PENDING // Pendiente de devolución
  RETURNED // Devuelto
}

// ============================================================
// 📦 MÓDULO DE KITS/COMBOS
// ============================================================

// ------------------------------------------------------------
// Items que componen un Kit/Combo
// ------------------------------------------------------------
model KitItem {
  id Int @id @default(autoincrement())

  // Relación con el kit (Product con isKit = true)
  kitId Int
  kit   Product @relation("Kit", fields: [kitId], references: [id], onDelete: Cascade)

  // Relación con producto que forma parte del kit
  productId Int
  product   Product @relation("KitProduct", fields: [productId], references: [id])

  // Relación con presentación (opcional)
  presentationId Int?
  presentation   ProductPresentation? @relation(fields: [presentationId], references: [id])

  // Cantidad de este producto en el kit
  quantity Float @default(1)

  // Orden de visualización
  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kitId, productId, presentationId]) // Evitar duplicados
  @@index([kitId])
  @@index([productId])
}

// ============================================================
// 🖨️ MÓDULO DE IMPRESORAS
// ============================================================

// ------------------------------------------------------------
// Impresoras registradas
// ------------------------------------------------------------
model Printer {
  id        Int     @id @default(autoincrement())
  name      String  @unique // Nombre de la impresora (ej: "EPSON L3110")
  isDefault Boolean @default(false) // Si es la impresora predeterminada

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDefault])
  @@index([name])
}

// ============================================================
// 🏢 MÓDULO DE PROVEEDORES Y COMPRAS
// ============================================================

// ------------------------------------------------------------
// Proveedores
// ------------------------------------------------------------
model Supplier {
  id          Int     @id @default(autoincrement())
  name        String // Nombre del proveedor
  code        String? @unique // Código único del proveedor
  contactName String? // Nombre de contacto
  phone       String? // Teléfono
  email       String? // Email
  address     String? // Dirección
  rfc         String? // RFC (México)
  taxId       String? // ID fiscal (para otros países)
  notes       String? // Notas adicionales
  status      Int     @default(1) // 1 = activo, 0 = inactivo

  // Relaciones
  purchases       Purchase[]
  accountsPayable AccountPayable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([code])
  @@index([status])
}

// ------------------------------------------------------------
// Compras
// ------------------------------------------------------------
model Purchase {
  id         Int      @id @default(autoincrement())
  folio      String   @unique // Folio único de la compra
  supplierId Int // Proveedor
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  // Información de la compra
  purchaseDate DateTime  @default(now()) // Fecha de compra
  dueDate      DateTime? // Fecha de vencimiento (si es a crédito)
  total        Float // Total de la compra
  subtotal     Float // Subtotal (sin impuestos)
  tax          Float     @default(0) // Impuestos
  discount     Float     @default(0) // Descuento

  // Estado de pago
  paymentStatus String  @default("PENDING") // PENDING, PARTIAL, PAID
  paymentMethod String? // CASH, TRANSFER, CHECK, CREDIT
  
  // Información de pago
  paidAmount      Float @default(0) // Monto pagado
  balance         Float @default(0) // Saldo pendiente (total - paidAmount)
  paidPercentage  Float @default(0) // Porcentaje pagado
  pendingPercentage Float @default(0) // Porcentaje pendiente

  // Información adicional
  invoiceNumber String? // Número de factura
  notes         String? // Notas
  branch        String? @default("Sucursal Default") // Sucursal
  cashRegister  String? @default("Caja 1") // Caja

  // Relaciones
  details  PurchaseDetail[]
  payments AccountPayable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([purchaseDate])
  @@index([paymentStatus])
  @@index([folio])
}

// ------------------------------------------------------------
// Detalles de Compra
// ------------------------------------------------------------
model PurchaseDetail {
  id         Int      @id @default(autoincrement())
  purchaseId Int // Compra
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId Int // Producto
  product   Product @relation(fields: [productId], references: [id])

  quantity Float // Cantidad comprada
  unitCost Float // Costo unitario
  subtotal Float // Subtotal (quantity * unitCost)
  discount Float @default(0) // Descuento aplicado

  createdAt DateTime @default(now())

  @@index([purchaseId])
  @@index([productId])
}

// ------------------------------------------------------------
// Cuentas por Pagar
// ------------------------------------------------------------
model AccountPayable {
  id         Int       @id @default(autoincrement())
  purchaseId Int? // Compra relacionada (opcional, puede ser pago directo)
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  supplierId Int // Proveedor
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  // Información del pago
  amount     Float // Monto a pagar
  paidAmount Float @default(0) // Monto pagado
  balance    Float // Saldo pendiente (amount - paidAmount)

  dueDate     DateTime // Fecha de vencimiento
  paymentDate DateTime? // Fecha de pago (si ya se pagó)

  // Estado
  status        String  @default("PENDING") // PENDING, PARTIAL, PAID, OVERDUE
  paymentMethod String? // Método de pago usado

  // Información adicional
  notes     String? // Notas
  reference String? // Referencia de pago (número de cheque, transferencia, etc.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([purchaseId])
  @@index([status])
  @@index([dueDate])
}
